{
    "name": "voxel/voxelbooking",
    "description": "Self-hosted multi-tenant booking system",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "league/oauth2-server": "^9.3",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "opis/json-schema": "^2.6",
        "phpmailer/phpmailer": "^6.9",
        "rlanvin/php-rrule": "^2.4",
        "robinvdvleuten/ulid": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
