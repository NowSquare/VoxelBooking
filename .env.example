# VoxelBooking Environment Configuration
# Production: the installer creates .env automatically during setup.
# Local/dev: copy this file to .env and adjust values before starting.

# ── Application ──
APP_NAME=VoxelBooking
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en
FORCE_HTTPS=true

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voxelbooking
DB_USERNAME=root
DB_PASSWORD=

# ── Mail ──
# Optional — SMTP can also be configured via the installation wizard
# (Step 3) or Admin → Settings → Email. Database settings take precedence;
# these .env values are used as fallback only when a setting has NO row in
# the database (i.e., never configured via the admin UI). If a DB row exists
# with an empty value, the .env fallback is NOT applied.
# The password is never displayed in the admin UI.
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
