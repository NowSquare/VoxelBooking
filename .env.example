# VoxelBooking Environment Configuration
# Production: the installer creates .env automatically during setup.
# Local/dev: copy this file to .env and adjust values before starting.

# ── Application ──
APP_NAME=VoxelBooking
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en
FORCE_HTTPS=true

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voxelbooking
DB_USERNAME=root
DB_PASSWORD=

# ── Mail ──
# Supported transports: smtp, resend, mailpit, log
#
# smtp   — Standard SMTP via PHPMailer (ports 465/587)
# resend — Resend HTTP API over HTTPS (port 443). Use this when your
#          hosting provider blocks outbound SMTP ports (common on
#          DigitalOcean, Hetzner, etc.). Set MAIL_PASSWORD to your
#          Resend API key. MAIL_HOST/PORT/ENCRYPTION are ignored.
# mailpit — Local dev email capture (localhost:1025)
# log     — Write to email_log table only, no outbound connection
#
# Database settings take precedence; these .env values are used as
# fallback only when a setting has NO row in the database (i.e., never
# configured via the admin UI).
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
